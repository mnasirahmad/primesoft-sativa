# Sativa Cosmetics ERP - Apache / StackCP Production Build (.htaccess)
# Automatically copied into dist/.htaccess during `npm run build`

DirectoryIndex index.html
Options -Indexes

# Correct MIME types for ES modules, WebP brand assets, and fonts
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType application/json .json
</IfModule>

# Protect sensitive hidden/config/database files if exposed
<FilesMatch "^(\.env.*|\.git.*|mysql-config\.json|package(-lock)?\.json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<FilesMatch "\.(sql|log|ts|tsx)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Single Page Application (SPA) Routing Fallback
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS if behind Apache SSL termination (uncomment if needed)
  # RewriteCond %{HTTPS} !=on
  # RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Do not rewrite API endpoints or existing files/directories
  RewriteCond %{REQUEST_URI} !^/api(/|$) [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# Cache Policy & Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  <FilesMatch "\.(js|css|webp|png|jpg|jpeg|svg|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
